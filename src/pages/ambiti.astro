---
/**
 * Ambiti — i tre filoni del portfolio dello studio, in righe alternate con
 * scheda foto in tilt 3D. data-tilt regola l'inclinazione al mouse: non rimuoverlo.
 *
 * L'elenco puntato di ogni ambito non è testo di marketing: sono i progetti veri
 * pubblicati in quella sezione, presi dalla collection.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GetStartedButton from '../components/GetStartedButton.astro';

const progetti = (await getCollection('progetti')).sort((a, b) => a.data.order - b.data.order);
const di = (key: string) => progetti.filter((p) => p.data.category === key);

// Le tre sezioni del portfolio della cliente.
// [[DA VALIDARE: descrizioni composte da noi con frasi della cliente (sito e Instagram)]]
const AMBITI = [
  {
    key: 'nuove-costruzioni',
    num: '01',
    title: "Nuove costruzioni",
    sum: "Progetto la casa dalla prima idea agli elaborati, curando funzionalità, luce e vivibilità. E seguo il cantiere fino alla consegna.",
  },
  {
    key: 'ristrutturazioni',
    num: '02',
    title: "Ristrutturazioni",
    sum: "Coordino imprese, artigiani e fornitori, gestisco tempistiche e imprevisti. Perché ristrutturare casa dovrebbe essere un'esperienza entusiasmante, non una fonte di stress.",
  },
  {
    key: 'interior',
    num: '03',
    title: "Interior design",
    sum: "Distribuzione degli spazi, materiali e arredi su misura, in presenza o a distanza. Equilibrio tra funzionalità, estetica e benessere.",
  },
].map((a) => ({ ...a, lavori: di(a.key) }));
---

<BaseLayout
  title="Ambiti · Sara Tonelli Studio"
  description="Nuove costruzioni, ristrutturazioni e interior design: i progetti di Sara Tonelli Studio, ingegnere civile e interior designer a Sassuolo (MO)."
>
  <main id="main">
    <section class="shead section">
      <div class="container">
        <p class="eyebrow" data-reveal>Ambiti</p>
        {/* [[DA VALIDARE: titolo scritto da noi sulle tre categorie del portfolio]] */}
        <h1 class="display shead__title" data-reveal>Costruire, ristrutturare,<br />abitare</h1>
        <p class="lead shead__lead" data-reveal>
          Progetto spazi e amo farlo da quando ero piccola. Per me, una casa ben pensata può rendere la vita più semplice, più leggera e più tua. Sono qui per aiutarti a costruire uno spazio che ti somigli davvero.
        </p>
        <p class="muted shead__note" data-reveal>
          Essere cresciuta accanto a un’impresa edile mi ha insegnato che un progetto non si conclude con un disegno. È in cantiere che prende davvero forma.
        </p>
      </div>
    </section>

    <section class="section slist section--tint">
      <div class="container">
        {AMBITI.map((lv, i) => (
          <article class="srow" data-reveal>
            <div class="srow__media">
              <div class="scard" data-tilt>
                <Image
                  src={lv.lavori[0].data.cover}
                  alt={`${lv.title}: ${lv.lavori[0].data.title}`}
                  widths={[600, 900, 1400]}
                  sizes="(min-width:820px) 44vw, 90vw"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  class="scard__photo"
                />
                <span class="scard__scrim" aria-hidden="true"></span>
                <div class="scard__face">
                  <span class="scard__num">{lv.num}</span>
                  <span class="scard__meta">
                    <span class="scard__letter">{lv.lavori.length}</span>
                    <span class="scard__label">progetti</span>
                  </span>
                </div>
                <span class="scard__glow" aria-hidden="true"></span>
              </div>
            </div>
            <div class="srow__body">
              <h2 class="srow__title">{lv.title}</h2>
              <p class="srow__sum lead">{lv.sum}</p>
              <ul class="srow__points">
                {lv.lavori.slice(0, 6).map((p) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                    <span><a href={`/progetti/${p.id}/`}>{p.data.title}</a>{p.data.year ? ` · ${p.data.year}` : ''}</span>
                  </li>
                ))}
                {lv.lavori.length > 6 && (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
                    <span><a href="/progetti/">e altri {lv.lavori.length - 6} progetti &#8599;</a></span>
                  </li>
                )}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section slxl on-dark">
      <div class="container slxl__grid">
        <div>
          <p class="eyebrow" data-reveal>Parliamone</p>
          <h2 class="h-section" data-reveal>Parlami del tuo progetto</h2>
        </div>
        <div data-reveal>
          <p class="lead muted slxl__p">
            Il mio obiettivo è semplificare ogni fase della ristrutturazione, coordinando le figure coinvolte. Perché ristrutturare casa dovrebbe essere un'esperienza entusiasmante, non una fonte di stress.
          </p>
          <div class="slxl__cta">
            <GetStartedButton href="/contatti/" label="Parliamone" />
            <a class="btn btn--on-dark" href="/metodo/">I servizi</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  // Tilt 3D delle schede foto al passaggio del mouse. Codice invariato.
const m=window.matchMedia("(prefers-reduced-motion: reduce)").matches;m||document.querySelectorAll("[data-tilt]").forEach(e=>{let o=0;e.addEventListener("mousemove",n=>{const t=e.getBoundingClientRect(),r=(n.clientX-t.left)/t.width,s=(n.clientY-t.top)/t.height;o||(o=requestAnimationFrame(()=>{e.style.setProperty("--mx",`${r*100}%`),e.style.setProperty("--my",`${s*100}%`);const i=(r-.5)*12*2,l=-(s-.5)*12*2;e.style.transform=`rotateX(${l}deg) rotateY(${i}deg)`,o=0}))}),e.addEventListener("mouseleave",()=>{e.style.transform="rotateX(0deg) rotateY(0deg)"})});</script>

<style>
.shead {
  padding-top:calc(var(--header-h) + clamp(2.5rem,6vw,5rem));
  padding-bottom:0
}

.shead__title {
  margin:1rem 0 1.6rem
}

.shead__lead {
  max-width:46rem
}

.shead__note {
  max-width:42rem;
  margin-top:1.2rem
}

.srow {
  display:grid;
  grid-template-columns:minmax(300px,44%) 1fr;
  gap:clamp(1.5rem,4vw,4rem);
  padding-block:clamp(2.5rem,5vw,4rem);
  border-top:1px solid var(--line);
  align-items:center
}

.srow:first-child {
  border-top:2px solid var(--ink)
}

.srow__media {
  perspective:1100px
}

.scard {
  position:relative;
  width:100%;
  aspect-ratio:4 / 3;
  overflow:hidden;
  transform-style:preserve-3d;
  will-change:transform;
  background:var(--dark);
  box-shadow:0 24px 50px -28px #11111199;
  transition:transform .5s var(--ease),box-shadow .4s var(--ease)
}

.scard__photo {
  position:absolute;
  inset:0;
  width:100%;
  height:100%;
  object-fit:cover
}

.scard__scrim {
  position:absolute;
  inset:0;
  z-index:1;
  background:linear-gradient(135deg,#081a1e00 42%,#081a1ec7)
}

.scard__face {
  position:absolute;
  inset:0;
  padding:1.3rem 1.5rem;
  z-index:3;
  display:flex;
  flex-direction:column;
  justify-content:space-between
}

.scard__num {
  font-size:.74rem;
  font-weight:600;
  letter-spacing:.14em;
  color:#ffffffd9
}

.scard__meta {
  display:flex;
  align-items:baseline;
  gap:.7rem
}

.scard__letter {
  font-family:var(--font-display);
  font-size:clamp(3.2rem,6vw,4.6rem);
  font-weight:600;
  line-height:.9;
  letter-spacing:-.03em;
  color:#fff;
  transition:color .4s var(--ease)
}

.scard__label {
  font-size:.7rem;
  font-weight:600;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:#ffffffb3
}

.scard__glow {
  position:absolute;
  inset:0;
  z-index:2;
  pointer-events:none;
  opacity:0;
  transition:opacity .35s var(--ease);
  mix-blend-mode:screen;
  background:radial-gradient(220px circle at var(--mx, 50%) var(--my, 50%),rgba(5,116,131,.55),transparent 60%)
}

.srow:hover .scard {
  box-shadow:0 36px 70px -28px #111111b3
}

.srow:hover .scard__glow {
  opacity:1
}

.srow:hover .scard__letter {
  color:var(--accent-on-dark)
}

.srow__title {
  font-size:clamp(1.6rem,3vw,2.4rem);
  letter-spacing:-.02em
}

.srow__sum {
  margin:.8rem 0 1.6rem;
  max-width:40rem
}

.srow__points {
  list-style:none;
  margin:0;
  padding:0;
  columns:2;
  column-gap:2.5rem
}

.srow__points li {
  display:flex;
  gap:.6rem;
  align-items:flex-start;
  padding:.45rem 0;
  break-inside:avoid;
  font-size:.95rem
}

.srow__points svg {
  color:var(--accent);
  flex:none;
  margin-top:.2rem
}

.slxl__grid {
  display:grid;
  grid-template-columns:1fr 1.2fr;
  gap:clamp(2rem,5vw,4rem);
  align-items:center
}

.slxl__p {
  margin:0 0 1.8rem
}

.slxl__cta {
  display:flex;
  gap:1rem;
  flex-wrap:wrap
}

@media(max-width:820px) {
  .srow {
    grid-template-columns:1fr;
    gap:1.5rem
  }
  .srow__points {
    columns:1
  }
  .slxl__grid {
    grid-template-columns:1fr
  }
}

@media(prefers-reduced-motion:reduce) {
  .scard {
    transition:box-shadow .3s
  }
}
</style>
